<?xml version="1.0" encoding="utf-8"?>
<!--
    Pre-Android-12 equivalent of data_extraction_rules.xml, for the same reason: the WebView's storage holds
    an identity key, an app-lock verifier and a cache of decrypted messages, none of which should be copied
    off the device. See that file for the full reasoning.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
