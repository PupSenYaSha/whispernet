# Every environment variable the server, the host scripts and the desktop shell read, with the default each
# one actually uses. `.env.example` is tracked (`.gitignore` negates it) precisely so this list can be read;
# `.env` itself is ignored and must never be committed.
#
# Nothing here is a secret. ADMIN_KEY is the only value that should be chosen rather than copied, and even
# that is optional - with it unset the admin routes are simply absent.

# --- where the app is served from ------------------------------------------------------
# Load-bearing for the Content-Security-Policy. `connect-src` is built from this value, so if it is wrong
# or missing, the client is refused its own websocket and API from the browser while everything else looks
# fine. No scheme: the server strips one if present. Leave it as the public hostname with no path.
PUBLIC_HOST=rightfully-nice-ram.cloudpub.ru

# --- listening sockets -----------------------------------------------------------------
# PORT=50025
# The app server. 127.0.0.1 on purpose: it sits behind a tunnel, and binding 0.0.0.0 would put it on every
# interface including whatever else the host answers on.
HOST=127.0.0.1
# The marketing site server, started by scripts/start.js when site/ exists.
SITE_PORT=3000

# --- persistence -----------------------------------------------------------------------
# Where the SQLite database and local media live. `data/` beside the repository by default.
DATA_DIR=

# --- media -----------------------------------------------------------------------------
# The host uploads are forwarded to. Compared against scheme, hostname and port on every proxied request, so
# changing it changes which hosts the server will fetch from.
MEDIA_BASE_URL=https://img.n1ko.dev
# `remote` (the default) forwards uploads to MEDIA_BASE_URL. `local` keeps them under DATA_DIR/media, which
# is what a host with no media service of its own should use.
MEDIA_STORAGE=remote

# --- TLS --------------------------------------------------------------------------------
# The server serves https itself when a key and a certificate are both present, and plain http otherwise.
# HTTPS_KEY and TLS_KEY are read as fallbacks for one another, and the same for the certificates.
TLS_KEY=
TLS_CERT=
HTTPS_KEY=
HTTPS_CERT=

# --- reverse proxy ---------------------------------------------------------------------
# `1` means "req.ip is the address of the proxy in front of me, not the caller's". Only enable it when
# something really is proxying: with it on and nothing proxying, every caller shares one address, and the
# per-address rate limits and registration limits all apply to the whole world as one caller.
TRUST_PROXY=1

# --- release ----------------------------------------------------------------------------
# The tag site/downloads/ redirects to when a binary is not in the working copy. Validated against
# /^v[0-9A-Za-z][0-9A-Za-z.+-]*$/ before it goes into a Location header.
RELEASE_TAG=v1.0.0

# --- administration ---------------------------------------------------------------------
# Without it the admin routes do not exist. With it, keep it out of the repository and off shared hosts.
ADMIN_KEY=

# --- limits -----------------------------------------------------------------------------
# All of these exist to bound one account's cost to the server, so raising them is a decision about what
# this host can absorb. `DISABLE_RATE_LIMITS=1` removes every upload and auth limit and is for a test run
# against a local database only - never on a public deployment.
# MAX_AUTH_ATTEMPTS=300
# Charged on every sign-in frame, including successful ones, because it bounds bcrypt work rather than
# mistakes. The client re-sends auth_login on every reconnect, so this has to clear an ordinary reconnect
# storm from one shared address - a school or an office behind one NAT.
# MAX_AUTH_ATTEMPTS_PER_ADDRESS=120
# MAX_REGISTRATIONS_PER_IP=40
# MAX_ACCOUNTS_PER_DEVICE=6
# POW_BITS=20
# POW_CHALLENGE_TTL_MS=600000
# POW_MAX_CHALLENGES=5000
# MAX_UPLOAD_SIZE=1048576000
# MAX_CONNECTIONS=10000
# DISABLE_RATE_LIMITS=

# --- desktop shell (src-tauri) ---------------------------------------------------------
# `https://` or nothing. A non-https value is refused at runtime and the built-in default is used instead,
# because these put the whole app and the privileged WebView's target on the wire.
# WHISPERNET_URL=https://rightfully-nice-ram.cloudpub.ru
# UPDATE_URL=https://api.github.com/repos/PupSenYaSha/whispernet
# Set to 1/true/yes to install an update that has no valid signature. That is a statement that you are
# willing to run a build you cannot verify; the release workflow does not need it and neither should a user.
# ALLOW_UNVERIFIED_UPDATES=