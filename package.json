{
  "name": "whispernet",
  "version": "1.0.0",
  "description": "Modern minimalist messenger",
  "author": "PupSenYaSha",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prestart": "node scripts/prepare.js",
    "start": "npm run build:client && node scripts/start.js",
    "start:server": "tsx server/index.ts",
    "dev": "node node_modules/vite/bin/vite.js",
    "build:client": "node node_modules/vite/bin/vite.js build",
    "icons": "node scripts/generate-icons.cjs",
    "cap:sync": "cap sync",
    "cap:android": "cap sync android",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "tauri:dev": "tauri dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run build:client && npm run test:e2e"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.10.0",
    "html5-qrcode": "^2.3.8",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^4.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "canvas": "^3.2.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
